# Cổng chạy server API
PORT=4000

# Danh sách domain FE được phép gọi API (cách nhau bởi dấu phẩy), để * nếu muốn cho phép tất cả (chỉ nên dùng khi test)
CORS_ORIGIN=*

# Token bí mật để CRON JOB / hệ thống nội bộ gọi API mark-paid thủ công (không bắt buộc)
INTERNAL_API_TOKEN=change-me-internal-token

# ============== SePay ==============
# Token SePay gửi kèm header "Authorization: Apikey <token>" khi gọi webhook về server của bạn.
# Vào SePay > Cấu hình > Webhook để lấy/đặt token này, phải khớp với giá trị cấu hình trong trang Admin > Cài đặt.
SEPAY_WEBHOOK_TOKEN=change-me-sepay-webhook-token

# ============== TheAPIBank (hoặc dịch vụ "thuê API ngân hàng" tương đương) ==============
# Các giá trị mặc định này chỉ dùng khi KHÔNG cấu hình qua trang Admin > Cài đặt.
THUEAPIBANK_BASE_URL=https://thueapibank.vn
THUEAPIBANK_API_TOKEN=
THUEAPIBANK_CRON_INTERVAL_MINUTES=5
